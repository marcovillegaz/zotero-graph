{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/core", "src/view", "src/adapters/json-adapter.ts", "scripts", "fixtures/*.ts", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "build"]
}
