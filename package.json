{
  "name": "zotero-library-graph",
  "version": "0.0.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/marcovillegaz/zotero-library-graph.git" },
  "type": "module",
  "config": { "prefsPrefix": "extensions.zotero-library-graph" },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/env-guard.ts && zotero-plugin serve",
    "dev:view": "vite --config vite.config.ts",
    "build": "zotero-plugin build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.zotero.json",
    "test:unit": "vitest run",
    "test:view": "playwright test",
    "test:zotero": "tsx scripts/env-guard.ts && echo \"test:zotero: pendiente (Fase 2)\"",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "fixture": "tsx fixtures/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  }
}
