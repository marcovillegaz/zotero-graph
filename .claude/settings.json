{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(D:/Users/marco/Zotero/**)",
      "Edit(D:/Users/marco/Zotero/**)",
      "Write(D:/Users/marco/Zotero/**)",
      "Read(~/AppData/Roaming/Zotero/**)",
      "Edit(~/AppData/Roaming/Zotero/**)",
      "Write(~/AppData/Roaming/Zotero/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Glob|Grep",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-real-library.mjs" }]
      }
    ]
  }
}
